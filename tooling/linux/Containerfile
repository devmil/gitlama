FROM docker.io/library/ubuntu@sha256:9abcaffc92a5279fff3a6a41635c0800ea33e528425fb389658806476e7defde
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
 ca-certificates git curl unzip xz-utils python3 python3-venv \
 clang build-essential cmake ninja-build pkg-config binutils \
 libgtk-3-dev libegl1-mesa-dev libgles2-mesa-dev libepoxy-dev \
 libx11-dev libxrandr-dev libxi-dev libxfixes-dev libxcomposite-dev \
 libxcursor-dev libxdamage-dev libxext-dev libxrender-dev libwayland-dev \
 libglu1-mesa-dev at-spi2-core dbus-x11 xvfb xauth fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1001 builder
USER builder
WORKDIR /workspace
