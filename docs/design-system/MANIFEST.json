{
  "schema": "gitlama.design-manifest.v1",
  "name": "Meridian",
  "product": "GitLama",
  "version": "3.0.2",
  "adopted": "2026-09-25",
  "entry": "README.md",
  "specimen": "specimens/index.html",
  "authorityOrder": [
    "tokens/gitlama-tokens.json",
    "specs/*.md",
    "specs/*.json",
    "foundations.md",
    "components/*.md",
    "specimens/*.html",
    "components/reference/*"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "densities": {
    "compact": 24,
    "regular": 28,
    "comfortable": 32
  },
  "viewports": [
    {
      "id": "compact-minimum",
      "width": 900,
      "height": 600,
      "fontScale": 1,
      "sidebar": "rail"
    },
    {
      "id": "laptop",
      "width": 1280,
      "height": 720,
      "fontScale": 1,
      "sidebar": "expanded"
    },
    {
      "id": "desktop",
      "width": 1440,
      "height": 900,
      "fontScale": 1,
      "sidebar": "expanded"
    },
    {
      "id": "wide",
      "width": 1920,
      "height": 1080,
      "fontScale": 1,
      "sidebar": "expanded"
    },
    {
      "id": "desktop-scaled",
      "width": 1440,
      "height": 900,
      "fontScale": 1.3,
      "sidebar": "content-dependent"
    }
  ],
  "surfaces": {
    "shell": [
      "welcome",
      "loading",
      "repository-error",
      "history",
      "changes"
    ],
    "persistent": [
      "toolbar-and-compass",
      "repository-tabs",
      "sidebar",
      "logbook",
      "status-bar"
    ],
    "workflows": [
      "rebase",
      "conflict",
      "blame-path-history",
      "stashes",
      "pull-request-review",
      "patch",
      "deep-graph-tools",
      "settings",
      "palette",
      "shortcut-reference"
    ]
  },
  "requiredStates": [
    "ready",
    "loading",
    "empty",
    "disabled",
    "attention",
    "error",
    "running",
    "complete"
  ],
  "contracts": {
    "foundations": "foundations.md",
    "tokens": "tokens/gitlama-tokens.json",
    "tokensCss": "tokens/gitlama-tokens.css",
    "components": "components/README.md",
    "icons": "assets/icons/inventory.json",
    "graph": "specs/graph.md",
    "changesAndDiff": "specs/changes-and-diff.md",
    "workflows": "specs/workflows.md",
    "inspector": "specs/inspector.md",
    "interactionAccessibility": "specs/interaction-accessibility.md",
    "captures": "specs/capture-matrix.json",
    "flutter": "FLUTTER_ADAPTATION.md"
  },
  "fixtureOracles": {
