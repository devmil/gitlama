{
  "schema": "gitlama.capture-matrix.v1",
  "version": "3.0.0",
  "referenceSpecimen": "../specimens/workspace.html",
  "componentSpecimen": "../specimens/index.html",
  "flutterBaselineRoot": "test/goldens/meridian",
  "defaults": {
    "devicePixelRatio": 1,
    "fontScale": 1,
    "density": "regular",
    "theme": "light",
    "pixelTolerance": 0.015,
    "changedPixelRatio": 0.005
  },
  "viewports": [
    { "id": "compact-minimum", "width": 900, "height": 600, "fontScale": 1, "sidebar": "rail" },
    { "id": "laptop", "width": 1280, "height": 720, "fontScale": 1, "sidebar": "expanded" },
    { "id": "desktop", "width": 1440, "height": 900, "fontScale": 1, "sidebar": "expanded" },
    { "id": "wide", "width": 1920, "height": 1080, "fontScale": 1, "sidebar": "expanded" },
    { "id": "desktop-scaled", "width": 1440, "height": 900, "fontScale": 1.3, "sidebar": "content-dependent" }
  ],
  "rules": [
    "Every Flutter capture uses deterministic fixture data and disables non-essential motion.",
    "Compare stable regions only. Native window decoration, font rasterization and caret blinking are masked.",
    "The HTML specimens are the visual reference for composition, colour and spacing; Flutter captures are the acceptance artefact.",
    "A changed baseline requires a MANIFEST.json version bump and a reviewer note naming the design decision."
  ],
  "captures": [
    { "id": "shell-history-light", "viewport": "laptop", "theme": "light", "density": "regular", "state": "history-ready",
      "assert": ["History island is focused and its selection is solid polar", "Detail island selection is polar-soft", "Compass shows repo, branch and sync", "author, hash and date are visible on every row"] },
    { "id": "shell-history-dark", "viewport": "desktop", "theme": "dark", "density": "comfortable", "state": "history-ready",
      "assert": ["islands are separated by the space-3 gutter with no hairline dividers", "lane-1 is the HEAD first-parent spine"] },
    { "id": "shell-changes-light", "viewport": "desktop", "theme": "light", "density": "regular", "state": "changes-ready",
      "assert": ["Unstaged and Staged lists keep 180 px minimum", "Composer is docked and not clipped", "hover actions have tooltips"] },
    { "id": "shell-compact-dark", "viewport": "compact-minimum", "theme": "dark", "density": "compact", "state": "history-ready",
      "assert": ["sidebar is a 56 px icon rail", "Detail stacks below History", "Fetch, Pull, Push and the Compass remain visible", "no horizontal scroll"] },
    { "id": "shell-compact-changes-light", "viewport": "compact-minimum", "theme": "light", "density": "compact", "state": "changes-ready",
      "assert": ["lists stack above the diff", "Commit action remains visible"] },
    { "id": "shell-wide-dark", "viewport": "wide", "theme": "dark", "density": "comfortable", "state": "history-ready",
      "assert": ["the Compass stays centred", "status bar is complete"] },
    { "id": "shell-scale-130", "viewport": "desktop-scaled", "theme": "light", "density": "regular", "state": "history-ready",
      "assert": ["labels may wrap but never clip", "all primary actions remain reachable", "metadata group stays visible"] },
    { "id": "shell-welcome", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "welcome",
      "assert": ["mark on fjord, display headline, Open, Clone and Create actions", "recent repositories have an empty treatment"] },
    { "id": "shell-loading", "viewport": "laptop", "theme": "light", "density": "regular", "state": "loading",
      "assert": ["skeleton rows, Compass progress rule", "loading does not imply an empty repository"] },
    { "id": "shell-error", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "repository-error",
      "assert": ["error Banner is persistent", "Retry and Details are visible"] },
    { "id": "shell-operation-running", "viewport": "desktop", "theme": "light", "density": "regular", "state": "operation-running",
      "assert": ["Compass shows the verb and progress rule", "Logbook opened without moving focus"] },
    { "id": "shell-conflict-banner", "viewport": "desktop", "theme": "dark", "density": "regular", "state": "rebase-paused",
      "assert": ["conflict Banner and Compass conflict count agree", "Continue is disabled with a reason"] },
    { "id": "workflow-rebase", "viewport": "desktop", "theme": "light", "density": "regular", "state": "rebase-ready" },
    { "id": "workflow-rebase-published", "viewport": "desktop", "theme": "dark", "density": "regular", "state": "rebase-published" },
    { "id": "workflow-conflict-text", "viewport": "desktop", "theme": "light", "density": "regular", "state": "conflict-text" },
    { "id": "workflow-conflict-compact", "viewport": "compact-minimum", "theme": "dark", "density": "compact", "state": "conflict-text" },
    { "id": "workflow-conflict-scale-130", "viewport": "desktop-scaled", "theme": "light", "density": "regular", "state": "conflict-text" },
    { "id": "workflow-conflict-file-level", "viewport": "desktop", "theme": "dark", "density": "regular", "state": "conflict-delete-modify" },
    { "id": "workflow-blame", "viewport": "desktop", "theme": "light", "density": "regular", "state": "blame-ready" },
    { "id": "workflow-stash", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "stash-ready" },
    { "id": "workflow-review-wide", "viewport": "wide", "theme": "light", "density": "regular", "state": "review-ready" },
    { "id": "workflow-review-drawer", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "review-drawer" },
    { "id": "workflow-patch", "viewport": "laptop", "theme": "light", "density": "regular", "state": "patch-ready" },
    { "id": "workflow-bisect", "viewport": "desktop", "theme": "dark", "density": "regular", "state": "bisect-running" },
    { "id": "overlay-settings", "viewport": "desktop", "theme": "light", "density": "regular", "state": "settings-appearance" },
    { "id": "overlay-settings-scale-130", "viewport": "desktop-scaled", "theme": "dark", "density": "regular", "state": "settings-appearance" },
    { "id": "overlay-palette", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "palette-query" },
    { "id": "overlay-palette-scale-130", "viewport": "desktop-scaled", "theme": "light", "density": "regular", "state": "palette-query" },
    { "id": "overlay-logbook", "viewport": "laptop", "theme": "light", "density": "regular", "state": "logbook-mixed" },
    { "id": "overlay-dialog-discard", "viewport": "laptop", "theme": "dark", "density": "regular", "state": "discard-confirm" },
    { "id": "gallery-light", "viewport": "desktop", "theme": "light", "density": "regular", "state": "component-gallery" },
    { "id": "gallery-dark", "viewport": "desktop", "theme": "dark", "density": "regular", "state": "component-gallery" },
    { "id": "gallery-reduced-motion", "viewport": "desktop", "theme": "light", "density": "regular", "state": "component-gallery", "reducedMotion": true }
  ]
}
