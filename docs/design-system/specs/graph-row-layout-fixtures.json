  "units": "logical-pixels",
  "purpose": "Row geometry oracle for the integrated history row: shared graph/ref/subject area on the left, author/hash/date pinned right. Rust computes it; Flutter measures field widths.",
  "inputContract": "rowWidth excludes scrollbar clearance. Field widths are measured/resolved for the current font/viewport. inkRightByPrimitive includes maximum stroke/ring extents of every primitive intersecting the row band, including offscreen-origin segments.",
  "tokens": {
    "contentGapPx": "space-4 (8)",
    "metadataGapPx": "space-5 (12)",
    "metadataFieldGapPx": "space-5 (12)",
    "rightInsetPx": "space-5 (12)",
    "laneOriginX": 9
  },
  "cases": [
    {
      "id": "sparse",
      "rowWidth": 900,
      "fieldWidths": [
        140,
        96,
        110
      ],
      "inkRightByPrimitive": [
        19
      ],
      "expected": {
        "metadataLeft": 518,
        "graphClipRight": 506,
        "contentStart": 27,
        "contentAvailable": 479
      }
    },
    {
