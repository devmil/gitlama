@@ -0,0 +1,131 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "flutter/shell/platform/linux/fl_resize_vsync.h"
+#include "gtest/gtest.h"
+class FlResizeVsyncTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    waiter = fl_resize_vsync_new(
+        [](gpointer data, intptr_t baton, uint64_t start, uint64_t target) {
+          auto* self = static_cast<FlResizeVsyncTest*>(data);
+          self->calls++;
+          self->baton = baton;
+          self->period = target - start;
+        },
+        this);
+    metrics.struct_size = sizeof(metrics);
+    metrics.width = 800;
+    metrics.height = 600;
+    metrics.pixel_ratio = 1;
+    metrics.view_id = 0;
+  }
+  void TearDown() override { g_clear_object(&waiter); }
+  void Drain() {
+    GMainLoop* loop = g_main_loop_new(nullptr, FALSE);
+    g_timeout_add(
+        30,
+        [](gpointer data) -> gboolean {
+          g_main_loop_quit(static_cast<GMainLoop*>(data));
+          return G_SOURCE_REMOVE;
+        },
+        loop);
+    g_main_loop_run(loop);
+    g_main_loop_unref(loop);
+  }
+  FlResizeVsync* waiter = nullptr;
+  FlutterWindowMetricsEvent metrics = {};
+  int calls = 0;
+  intptr_t baton = 0;
+  uint64_t period = 0;
+};
+TEST_F(FlResizeVsyncTest, MetricsBeforeRequest) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 123);
+  EXPECT_EQ(calls, 1);
+  EXPECT_EQ(baton, 123);
+}
+TEST_F(FlResizeVsyncTest, ResizeFlushesPendingExactlyOnce) {
+  fl_resize_vsync_request(waiter, 123);
+  EXPECT_EQ(calls, 0);
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  EXPECT_EQ(calls, 1);
+  Drain();
+  EXPECT_EQ(calls, 1);
+}
+TEST_F(FlResizeVsyncTest, OrdinaryFramesAreDeferred) {
+  fl_resize_vsync_request(waiter, 123);
+  g_main_context_iteration(nullptr, FALSE);
+  EXPECT_EQ(calls, 0);
+  Drain();
+  EXPECT_EQ(calls, 1);
+}
+TEST_F(FlResizeVsyncTest, DuplicateMetricsDoNotCreateEagerLoop) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 2);
+  EXPECT_EQ(calls, 1);
+  Drain();
+  EXPECT_EQ(calls, 2);
+}
+TEST_F(FlResizeVsyncTest, ViewOwnershipIsIndependent) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  metrics.view_id = 1;
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 2);
+  EXPECT_EQ(calls, 2);
+}
+TEST_F(FlResizeVsyncTest, RemovedViewIdCanBeReused) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  fl_resize_vsync_remove_view(waiter, 0);
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 2);
+  EXPECT_EQ(calls, 2);
+}
+TEST_F(FlResizeVsyncTest, ConstraintsChangeIsResize) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  metrics.has_constraints = true;
+  metrics.max_width_constraint = 900;
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 2);
+  EXPECT_EQ(calls, 2);
+}
+TEST_F(FlResizeVsyncTest, ScaleChangeIsResize) {
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  metrics.pixel_ratio = 2;
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 2);
+  EXPECT_EQ(calls, 2);
+}
+TEST_F(FlResizeVsyncTest, MonitorRefreshIsNotHardcodedTo60Hz) {
+  fl_resize_vsync_set_frame_clock(waiter, nullptr, 120);
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  EXPECT_EQ(period, 8333000u);
+}
+TEST_F(FlResizeVsyncTest, InvalidRefreshHasBoundedFallback) {
+  fl_resize_vsync_set_frame_clock(waiter, nullptr, 0);
+  fl_resize_vsync_notify_metrics(waiter, &metrics);
+  fl_resize_vsync_request(waiter, 1);
+  EXPECT_EQ(period, 16667000u);
+}
+TEST_F(FlResizeVsyncTest, ShutdownReturnsBatonAndCancelsTimer) {
+  fl_resize_vsync_request(waiter, 123);
+  fl_resize_vsync_shutdown(waiter);
+  EXPECT_EQ(calls, 1);
+  fl_resize_vsync_shutdown(waiter);
+  Drain();
+  EXPECT_EQ(calls, 1);
+}
+TEST_F(FlResizeVsyncTest, DisposeReturnsBatonWithoutTimerReferenceCycle) {
+  fl_resize_vsync_request(waiter, 123);
+  g_clear_object(&waiter);
+  EXPECT_EQ(calls, 1);
+  Drain();
+  EXPECT_EQ(calls, 1);
+}
