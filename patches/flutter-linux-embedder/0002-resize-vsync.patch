diff --git a/engine/src/flutter/shell/platform/linux/fl_resize_vsync.cc b/engine/src/flutter/shell/platform/linux/fl_resize_vsync.cc
new file mode 100644
--- /dev/null
+++ b/engine/src/flutter/shell/platform/linux/fl_resize_vsync.cc
@@ -0,0 +1,156 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "flutter/shell/platform/linux/fl_resize_vsync.h"
+#include <cmath>
+
+struct _FlResizeVsync {
+  GObject parent_instance;
+  GThread* owner;
+  GdkFrameClock* clock;
+  GHashTable* metrics;
+  FlResizeVsyncDelivery delivery;
+  gpointer data;
+  guint timer;
+  intptr_t baton;
+  gboolean pending;
+  gboolean resized;
+  gboolean stopped;
+  gint64 last_delivery;
+  gint64 fallback_interval;
+};
+G_DEFINE_TYPE(FlResizeVsync, fl_resize_vsync, G_TYPE_OBJECT)
+
+static gint64 interval(FlResizeVsync* self) {
+  gint64 value = self->fallback_interval;
+  if (self->clock != nullptr) {
+    gint64 predicted = 0;
+    gdk_frame_clock_get_refresh_info(self->clock, g_get_monotonic_time(),
+                                     &value, &predicted);
+  }
+  return value > 0 && value <= G_USEC_PER_SEC ? value : self->fallback_interval;
+}
+
+static void deliver(FlResizeVsync* self) {
+  if (!self->pending)
+    return;
+  if (self->timer != 0) {
+    g_source_remove(self->timer);
+    self->timer = 0;
+  }
+  intptr_t baton = self->baton;
+  self->pending = FALSE;
+  self->resized = FALSE;
+  self->last_delivery = g_get_monotonic_time();
+  uint64_t start = self->last_delivery * 1000;
+  self->delivery(self->data, baton, start, start + interval(self) * 1000);
+}
+
+static gboolean timer_cb(gpointer data) {
+  FlResizeVsync* self = FL_RESIZE_VSYNC(data);
+  self->timer = 0;
+  deliver(self);
+  return G_SOURCE_REMOVE;
+}
+
+static void fl_resize_vsync_dispose(GObject* object) {
+  FlResizeVsync* self = FL_RESIZE_VSYNC(object);
+  fl_resize_vsync_shutdown(self);
+  g_clear_object(&self->clock);
+  g_clear_pointer(&self->metrics, g_hash_table_unref);
+  G_OBJECT_CLASS(fl_resize_vsync_parent_class)->dispose(object);
+}
+static void fl_resize_vsync_class_init(FlResizeVsyncClass* klass) {
+  G_OBJECT_CLASS(klass)->dispose = fl_resize_vsync_dispose;
+}
+static void fl_resize_vsync_init(FlResizeVsync* self) {
+  self->owner = g_thread_self();
+  self->fallback_interval = 16667;
+  self->metrics =
+      g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, g_free);
+}
+FlResizeVsync* fl_resize_vsync_new(FlResizeVsyncDelivery delivery,
+                                   gpointer data) {
+  g_return_val_if_fail(delivery != nullptr, nullptr);
+  FlResizeVsync* self =
+      FL_RESIZE_VSYNC(g_object_new(fl_resize_vsync_get_type(), nullptr));
+  self->delivery = delivery;
+  self->data = data;
+  return self;
+}
+void fl_resize_vsync_request(FlResizeVsync* self, intptr_t baton) {
+  g_return_if_fail(FL_IS_RESIZE_VSYNC(self));
+  g_return_if_fail(self->owner == g_thread_self());
+  g_return_if_fail(!self->pending);
+  self->pending = TRUE;
+  self->baton = baton;
+  if (self->resized || self->stopped) {
+    deliver(self);
+    return;
+  }
+  gint64 now = g_get_monotonic_time();
+  gint64 period = interval(self);
+  gint64 phase = self->clock != nullptr
+                     ? gdk_frame_clock_get_frame_time(self->clock)
+                     : self->last_delivery;
+  gint64 due = phase <= 0    ? now + period
+               : phase > now ? phase
+                             : phase + ((now - phase) / period + 1) * period;
+  GSource* source = g_timeout_source_new(0);
+  g_source_set_callback(source, timer_cb, self, nullptr);
+  g_source_set_ready_time(source, due);
+  self->timer = g_source_attach(source, nullptr);
+  g_source_unref(source);
+}
+static gboolean equal_metrics(const FlutterWindowMetricsEvent* a,
+                              const FlutterWindowMetricsEvent* b) {
+  return a->width == b->width && a->height == b->height &&
+         a->pixel_ratio == b->pixel_ratio && a->display_id == b->display_id &&
+         a->has_constraints == b->has_constraints &&
+         a->min_width_constraint == b->min_width_constraint &&
+         a->min_height_constraint == b->min_height_constraint &&
+         a->max_width_constraint == b->max_width_constraint &&
+         a->max_height_constraint == b->max_height_constraint;
+}
+void fl_resize_vsync_notify_metrics(FlResizeVsync* self,
+                                    const FlutterWindowMetricsEvent* event) {
+  g_return_if_fail(FL_IS_RESIZE_VSYNC(self));
+  g_return_if_fail(self->owner == g_thread_self());
+  if (self->stopped)
+    return;
+  gint64 id = event->view_id;
+  const auto* previous = static_cast<FlutterWindowMetricsEvent*>(
+      g_hash_table_lookup(self->metrics, &id));
+  if (previous != nullptr && equal_metrics(previous, event))
+    return;
+  auto* key = g_new(gint64, 1);
+  *key = id;
+  auto* copy = g_new(FlutterWindowMetricsEvent, 1);
+  *copy = *event;
+  g_hash_table_replace(self->metrics, key, copy);
+  self->resized = TRUE;
+  deliver(self);
+}
+void fl_resize_vsync_remove_view(FlResizeVsync* self, FlutterViewId view_id) {
+  g_return_if_fail(FL_IS_RESIZE_VSYNC(self));
+  g_return_if_fail(self->owner == g_thread_self());
+  gint64 id = view_id;
+  g_hash_table_remove(self->metrics, &id);
+}
+void fl_resize_vsync_set_frame_clock(FlResizeVsync* self,
+                                     GdkFrameClock* clock,
+                                     double refresh_rate) {
+  g_return_if_fail(FL_IS_RESIZE_VSYNC(self));
+  g_return_if_fail(self->owner == g_thread_self());
+  g_set_object(&self->clock, clock);
+  self->fallback_interval =
+      std::isfinite(refresh_rate) && refresh_rate >= 1 && refresh_rate <= 1000
+          ? std::llround(G_USEC_PER_SEC / refresh_rate)
+          : 16667;
+}
+void fl_resize_vsync_shutdown(FlResizeVsync* self) {
+  g_return_if_fail(FL_IS_RESIZE_VSYNC(self));
+  g_return_if_fail(self->owner == g_thread_self());
+  self->stopped = TRUE;
+  deliver(self);
+}
