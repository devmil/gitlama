+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef FLUTTER_SHELL_PLATFORM_LINUX_FL_RESIZE_VSYNC_H_
+#define FLUTTER_SHELL_PLATFORM_LINUX_FL_RESIZE_VSYNC_H_
+#include <gtk/gtk.h>
+#include "flutter/shell/platform/embedder/embedder.h"
+G_BEGIN_DECLS
+G_DECLARE_FINAL_TYPE(FlResizeVsync, fl_resize_vsync, FL, RESIZE_VSYNC, GObject)
+typedef void (*FlResizeVsyncDelivery)(gpointer data,
+                                      intptr_t baton,
+                                      uint64_t start_nanos,
+                                      uint64_t target_nanos);
+// Owns vsync admission and its timer. All methods run on the engine platform
+// thread. data is borrowed and must outlive this object and its shutdown call.
+FlResizeVsync* fl_resize_vsync_new(FlResizeVsyncDelivery delivery,
+                                   gpointer data);
+void fl_resize_vsync_request(FlResizeVsync* self, intptr_t baton);
+// Send metrics to the engine before this call. Duplicate per-view metrics do
+// not consume another eager frame. Removed view IDs may be reused safely.
+void fl_resize_vsync_notify_metrics(FlResizeVsync* self,
+                                    const FlutterWindowMetricsEvent* metrics);
+void fl_resize_vsync_remove_view(FlResizeVsync* self, FlutterViewId view_id);
+// The current GTK clock supplies phase and refresh estimates; the monitor rate
+// is the fallback before a clock has timing history, including high-Hz outputs.
+void fl_resize_vsync_set_frame_clock(FlResizeVsync* self,
+                                     GdkFrameClock* clock,
+                                     double refresh_rate);
+// Returns any outstanding baton before FlutterEngineShutdown, removes timer
+// ownership, and is idempotent. Dispose also invokes shutdown.
+void fl_resize_vsync_shutdown(FlResizeVsync* self);
+G_END_DECLS
+#endif
