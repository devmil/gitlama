diff --git a/engine/src/flutter/shell/platform/linux/fl_view.cc b/engine/src/flutter/shell/platform/linux/fl_view.cc
--- a/engine/src/flutter/shell/platform/linux/fl_view.cc
+++ b/engine/src/flutter/shell/platform/linux/fl_view.cc
@@ -688,9 +688,14 @@
 // Engine related construction.
 static void setup_engine(FlView* self) {
   self->view_accessible = fl_view_accessible_new(self->engine, self->view_id);
-  fl_socket_accessible_embed(
-      FL_SOCKET_ACCESSIBLE(gtk_widget_get_accessible(GTK_WIDGET(self))),
-      atk_plug_get_id(ATK_PLUG(self->view_accessible)));
+  // The IPC bridge may not be loaded in headless/minimal GTK sessions.
+  // atk_plug_get_id transfers ownership; never pass a missing ID to AtkSocket.
+  g_autofree gchar* plug_id = atk_plug_get_id(ATK_PLUG(self->view_accessible));
+  if (plug_id != nullptr) {
+    fl_socket_accessible_embed(
+        FL_SOCKET_ACCESSIBLE(gtk_widget_get_accessible(GTK_WIDGET(self))),
+        plug_id);
+  }
 
   self->pointer_manager = fl_pointer_manager_new(self->view_id, self->engine);
 
diff --git a/engine/src/flutter/shell/platform/linux/fl_view_test.cc b/engine/src/flutter/shell/platform/linux/fl_view_test.cc
--- a/engine/src/flutter/shell/platform/linux/fl_view_test.cc
+++ b/engine/src/flutter/shell/platform/linux/fl_view_test.cc
@@ -10,6 +10,7 @@
 #include "flutter/shell/platform/linux/fl_engine_private.h"
 #include "flutter/shell/platform/linux/fl_renderable.h"
 #include "flutter/shell/platform/linux/fl_text_input_handler.h"
+#include "flutter/shell/platform/linux/fl_view_accessible.h"
 #include "flutter/shell/platform/linux/fl_view_private.h"
 #include "flutter/shell/platform/linux/testing/fl_test.h"
 #include "flutter/shell/platform/linux/testing/fl_test_gtk_logs.h"
@@ -256,3 +257,17 @@
   fl_gtk_widget_destroy(GTK_WIDGET(secondary_view));
   fl_gtk_widget_destroy(GTK_WIDGET(implicit_view));
 }
+
+TEST_F(FlViewTest, MissingAccessibilityBridgeIdDoesNotEmitCritical) {
+  auto* klass = ATK_PLUG_CLASS(g_type_class_ref(fl_view_accessible_get_type()));
+  auto original = klass->get_object_id;
+  klass->get_object_id = [](AtkPlug*) -> gchar* { return nullptr; };
+  FlView* view = fl_view_new(project);
+  g_object_ref_sink(view);
+  EXPECT_FALSE(
+      flutter::testing::fl_has_received_gtk_log_level(G_LOG_LEVEL_CRITICAL));
+  klass->get_object_id = original;
+  fl_gtk_widget_destroy(GTK_WIDGET(view));
+  g_object_unref(view);
+  g_type_class_unref(klass);
+}
