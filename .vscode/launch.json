{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GitLama (QML from the checkout)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--manifest-path", "rust-core/Cargo.toml", "-p", "gitlama"]
            },
            "env": { "GITLAMA_QML_DIR": "${workspaceFolder}/qml" }
        }
    ]
}
