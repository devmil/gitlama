.40-41.x86_64.rpm"},{"architecture":"x86_64","bytes":23198900,"file":"gitlama_0.1.0-beta.40-41_amd64.deb","format":"deb","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"b8b7101b134e1f146fe73c97aea0894443b17e2841c7ac9bc138db7909ff1503","url":"https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.40-41/gitlama_0.1.0-beta.40-41_amd64.deb"}],"build":41,"channel":"beta","notes":["Remote workspaces are no longer experimental: open repositories on other computers without turning on a setting first.","Choosing whether GitLama may change a host's repositories is now a clear Read only / Allow changes choice that takes effect immediately.","Hosts can have their own color and icon, shown on their tabs so you can tell at a glance which computer a tab belongs to.","Remote workspaces: image changes, including SVG files, are now shown for repositories on another computer, and external diff tools and diff renderers work for them too.","Remote workspaces: you can now create patches from a repository on another computer; the patch is saved on this computer."],"tag":"v0.1.0-beta.40-41","version":"0.1.0-beta.40"},{"assets":[{"architecture":"x86_64","bytes":22030840,"file":"GitLama-0.1.0-beta.39-40-linux-x86_64.AppImage","format":"AppImage","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"f217d5bfdbc14ebe636553ffbae4c8883d75a1eb189d697e7e3750c997a8345f","url":"https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.39-40/GitLama-0.1.0-beta.39-40-linux-x86_64.AppImage"},{"architecture":"x86_64","bytes":22995441,"file":"GitLama-0.1.0-beta.39-40-linux-x86_64.tar.gz","format":"tar.gz","minimum_system":"glibc 2.35 and Git 2.39","platform":"linux","sha256":"f65ab7d883e71bbd27151514947fe80e158d07b24c333aa83283dbee3f622360","url":"https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.39-40/GitLama-0.1.0-beta.39-40-linux-x86_64.tar.gz"},{"architecture":"arm64","bytes":24645801,"file":"GitLama-0.1.0-beta.39-40-macos-arm64.d