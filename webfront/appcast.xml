    <item>
      <title>GitLama 0.1.0-beta.68</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>69</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.68</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;Resizing the window on Linux no longer shows black flashes or black edges.&lt;/li&gt;&lt;li&gt;Bundle consecutive queued staging clicks for the same side. Stage large filtered folder selections in bounded batches, keeping hidden files untouched.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.68-69/GitLama-0.1.0-beta.68-69-macos-arm64.dmg" length="33855834" type="application/octet-stream" sparkle:edSignature="BDSoCbFgm002BjGuf8GVhBA122yLHrbp1QxT4veNQCZEyRWwxfo5aGf+u6pML6Vyh99Quz+O38iHLQPCRVdZAQ==" />
    </item>
    <item>
      <title>GitLama 0.1.0-beta.67</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>68</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.67</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;Text fields no longer show a touch-style drop under the cursor when a dialog opens with a prefilled name. Right-clicking selectable text on desktop opens the copy menu again.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.67-68/GitLama-0.1.0-beta.67-68-macos-arm64.dmg" length="33308402" type="application/octet-stream" sparkle:edSignature="iNUHPMb2pEdYCtGcRN99phOqe4FI1ICibAoPfwFotnak7h0+wqqh6LOe0RycKZkII8j4bz5owI/oIZ5bvuEFDw==" />
    </item>
