    <item>
      <title>GitLama 0.1.0-beta.61</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>62</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.61</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;The default branch’s CI status now sits inside its branch chip in History, matching pull request chips.&lt;/li&gt;&lt;li&gt;Creating a branch from the toolbar or sidebar now starts at the current commit. Creating one from History uses the chosen commit. If that commit is unavailable, GitLama lets you refresh and choose again while keeping your input. Switching repositories cannot apply an open branch dialog to another repository. Hosts receive a new GitLama helper.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.61-62/GitLama-0.1.0-beta.61-62-macos-arm64.dmg" length="33463140" type="application/octet-stream" sparkle:edSignature="D+vSo8LO2d/rXM3L6DjUXw6bM+PVT9L/eKZV4uciyAXc0Rg6qcW6luqkVbV+B5iFf3jj6mI12S0OZHYq/JC1Dw==" />
    </item>
