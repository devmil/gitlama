    <item>
      <title>GitLama 0.1.0-beta.66</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>67</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.66</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;Record safe diagnostic events for fetch, pull and push, including background fetch, with start, result and failure events and detailed timing.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.66-67/GitLama-0.1.0-beta.66-67-macos-arm64.dmg" length="33312270" type="application/octet-stream" sparkle:edSignature="T8gLYo+5j8Ejc36Iamd+sPACl2VKX7KVJIp4LCTgGX8E5RqWkLyL1rCqRIQp3+ka5xgvlSVM+cTRSYUKpqd2DA==" />
