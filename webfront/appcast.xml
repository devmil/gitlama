    <item>
      <title>GitLama 0.1.0-beta.65</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>66</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.65</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;GitLama is now open source under the MIT License. Its source code, releases and issue tracker are on GitHub.&lt;/li&gt;&lt;li&gt;On Windows, executable files in a commit saved as ZIP now stay executable when the archive is unpacked on macOS or Linux.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.65-66/GitLama-0.1.0-beta.65-66-macos-arm64.dmg" length="33711568" type="application/octet-stream" sparkle:edSignature="lKWrvGXmH52yvaYBE1xLBhnJ5x/iZVP64IsLJN2Pq8JI8osDW0SA5LH/EmXu+CnkSMtJN15VuyX5f2rsMZG6BQ==" />
    </item>
    <item>
      <title>GitLama 0.1.0-beta.64</title>
      <link>https://devmil.de/gitlama/releases.html</link>
      <sparkle:version>65</sparkle:version>
      <sparkle:shortVersionString>0.1.0-beta.64</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <description>&lt;ul&gt;&lt;li&gt;Fix Windows startup failing on accounts where Windows allows saved credentials only for the current sign-in session.&lt;/li&gt;&lt;/ul&gt;</description>
      <enclosure url="https://github.com/devmil/gitlama/releases/download/v0.1.0-beta.64-65/GitLama-0.1.0-beta.64-65-macos-arm64.dmg" length="33558384" type="application/octet-stream" sparkle:edSignature="0YxUp6JwiJ5b/Phq71I9gJ6KfTVvEOa02TRygPqwZz0blMF/ff9kx50i4BH6mVHiGIEYbDGrpZw+GEC8T/o+CQ==" />
