        ink: _hex(GitColors.lamaShades),
        paper: _hex(Theme.colors.pane),
        line: _hex(Theme.colors.line),
        muted: _hex(Theme.colors.inkMuted),
        accent: _hex(Theme.colors.accent),
        accentSoft: _hex(Theme.colors.accentSoft),
        danger: _hex(Theme.colors.danger)
    })
