import QtQuick
import QtQuick.Window
import Meridian

// The GitLama lama in a small scene that says what a detail pane shows when it
// has no diff to show (MeridianEmptyState.illustration): `moved` carries the
// file into a new folder, `renamed` wears a new name tag, `select` rests
// beside the files, `waiting` stands by an hourglass, `unchanged` nods at a
// file that reads the same, `failed` pushes its shades up at a torn file.
// The poses are resources/brand/lama-*.svg; the scene paints in theme colours
// and keeps the lama's own dark shades in both themes.
Item {
    id: root

    property string scene: "select"
    readonly property alias status: art.status
    readonly property alias source: art.source

    implicitWidth: GitLamaLayout.lamaSceneWidth
