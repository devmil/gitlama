    Accessible.ignored: true

    /// `#rrggbb` for SVG, which takes no alpha in a hex colour.
    function _hex(value) {
        const part = channel => ("0" + Math.round(channel * 255).toString(16)).slice(-2)
        return "#" + part(value.r) + part(value.g) + part(value.b)
    }
    readonly property var _colors: ({
        body: _hex(Theme.dark ? Theme.blend(Theme.colors.pane, Theme.colors.accent, GitLamaLayout.lamaSceneDarkBody)
